# Sheggar Wheels — environment variables (C#/.NET backend version)
#
# There are TWO apps now, each with its own .env:
#   1. backend/SheggarWheels.Api/   → the C# API (needs DATABASE_URL, SESSION_SECRET, ...)
#   2. the Next.js frontend root    → needs BACKEND_URL (where the API runs)
#
# ── BACKEND (backend/SheggarWheels.Api/.env or environment variables) ───────
#
# REQUIRED — the same PostgreSQL/Supabase database as before:
#   Local docker (repo's docker-compose.yml):
#     DATABASE_URL="Host=localhost;Port=5433;Database=sheggar_wheels;Username=sheggar;Password=sheggar"
#   Supabase (Session pooler URI, recommended for Render):
#     DATABASE_URL="Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT;Password=YOUR-PASSWORD"
#
# REQUIRED in production — generate once:  openssl rand -hex 32
SESSION_SECRET="change-me-to-64-random-hex-characters"
#
# OPTIONAL — Google sign-in (the button stays hidden until both values exist):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# OPTIONAL — token that protects POST /api/dev/seed (the demo data loader):
SEED_TOKEN="change-me-to-a-random-string"
#
# PORT is injected by Render automatically; locally the API listens on 5000.
#
# ── FRONTEND (Next.js root .env) ────────────────────────────────────────────
#
# Where the C# API runs. All browser /api/* calls are proxied here:
BACKEND_URL="http://localhost:5000"
# On Vercel: BACKEND_URL="https://sheggar-wheels-api.onrender.com"
#
# Public URL of the app (SEO metadata only):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
